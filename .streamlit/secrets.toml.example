# Copia este fichero a .streamlit/secrets.toml y rellena los valores.
# NUNCA lo subas a un repositorio: contiene credenciales.
# En Cloud Run puedes usar variables de entorno en lugar de este fichero.

# ---------------------------------------------------------------------------
# Hoja de Google compartida (criterios y seguimiento de oportunidades)
# ---------------------------------------------------------------------------
[sheets]
# ID de la hoja: el tramo entre /d/ y /edit de la URL.
spreadsheet_id = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

# ---------------------------------------------------------------------------
# Cuenta de servicio con acceso a la hoja (compártela como Editor con client_email)
# ---------------------------------------------------------------------------
[gcp_service_account]
type = "service_account"
project_id = "grefa-licitaciones"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "grefa-licitaciones@grefa-licitaciones.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# ---------------------------------------------------------------------------
# Login con la cuenta @grefa.org
# Omite este bloque entero para dejar la app abierta (desarrollo en local).
# Genera cookie_secret con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Streamlit Community Cloud: usa la URL de tu app, por ejemplo:
#   redirect_uri = "https://grefa-licitaciones.streamlit.app/oauth2callback"
# y anade esa misma URI en Google Cloud Console -> Credenciales OAuth.
# ---------------------------------------------------------------------------
[auth]
redirect_uri = "https://TU-APP.streamlit.app/oauth2callback"
cookie_secret = "cadena-larga-y-aleatoria-que-debes-cambiar"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---------------------------------------------------------------------------
# Quién puede entrar
# Si omites este bloque, se aplica igualmente el dominio grefa.org por defecto.
# ---------------------------------------------------------------------------
[access]
# Cualquier cuenta del dominio corporativo.
allowed_domains = ["grefa.org"]
# Y, además, estas direcciones sueltas (colaboradores externos, por ejemplo).
allowed_emails = []
