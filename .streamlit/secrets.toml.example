# Copia este fichero a .streamlit/secrets.toml y rellena los valores.
# NUNCA lo subas a un repositorio: contiene credenciales.
# En Cloud Run puedes usar variables de entorno en lugar de este fichero.

# ---------------------------------------------------------------------------
# Hoja de Google compartida (criterios y seguimiento de oportunidades)
# ---------------------------------------------------------------------------
[sheets]
# ID de la hoja: el tramo entre /d/ y /edit de la URL.
spreadsheet_id = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

# ---------------------------------------------------------------------------
# Cuenta de servicio con acceso a la hoja (compártela como Editor con client_email)
# ---------------------------------------------------------------------------
[gcp_service_account]
type = "service_account"
project_id = "grefa-licitaciones"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "grefa-licitaciones@grefa-licitaciones.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# ---------------------------------------------------------------------------
# Alertas al espacio Google Chat por EMAIL (sin webhook)
# ---------------------------------------------------------------------------
[alerts]
# En el espacio Chat → nombre → Configuración del espacio → Email → Generar correo
space_email = "TU-ESPACIO@googlegroups.com"

# Cuenta @grefa.org que envía (contraseña de aplicación de Google, no la normal)
smtp_host = "smtp.gmail.com"
smtp_port = 587
smtp_user = "licitaciones@grefa.org"
smtp_password = "CONTRASEÑA-DE-APLICACION-16-CARACTERES"
smtp_from = "GREFA Licitaciones <licitaciones@grefa.org>"

app_url = "https://grefa-licitaciones.streamlit.app"

# Opcional si el admin habilita webhooks:
# google_chat_webhook = "https://chat.googleapis.com/v1/spaces/..."

# ---------------------------------------------------------------------------
# Resumen de pliegos con IA (Gemini — tier gratuito en Google AI Studio)
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
[gemini]
api_key = "AIza..."
# Recomendado en tier gratuito (mejor cuota que gemini-3.x, ~20 req/día):
model = "gemini-2.5-flash"
# Si el principal satura, la app prueba estos automáticamente:
fallback_models = "gemini-flash-latest,gemini-2.5-flash-lite"

# ---------------------------------------------------------------------------
# Respaldo gratuito si Gemini agota cuota (orden: Gemini → Groq → OpenRouter)
# Claves: https://console.groq.com/keys  ·  https://openrouter.ai/keys
# ---------------------------------------------------------------------------
[groq]
api_key = "gsk_..."
# model = "llama-3.3-70b-versatile"

[openrouter]
api_key = "sk-or-..."
# model = "meta-llama/llama-3.3-70b-instruct:free"

# ---------------------------------------------------------------------------
# Búsqueda web de entidades (modo Ayudas y premios) — opcional
# Sin esto se usa DuckDuckGo HTML (gratis, sin clave).
# Google Programmable Search: https://programmablesearchengine.google.com/
# ---------------------------------------------------------------------------
[web_search]
# api_key = "AIza..."
# cx = "xxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Login con la cuenta @grefa.org
# Omite este bloque entero para dejar la app abierta (desarrollo en local).
# Genera cookie_secret con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Streamlit Community Cloud: usa la URL de tu app, por ejemplo:
#   redirect_uri = "https://grefa-licitaciones.streamlit.app/oauth2callback"
# y anade esa misma URI en Google Cloud Console -> Credenciales OAuth.
# ---------------------------------------------------------------------------
[auth]
redirect_uri = "https://TU-APP.streamlit.app/oauth2callback"
cookie_secret = "cadena-larga-y-aleatoria-que-debes-cambiar"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---------------------------------------------------------------------------
# Quién puede entrar
# Si omites este bloque, se aplica igualmente el dominio grefa.org por defecto.
# ---------------------------------------------------------------------------
[access]
# Cualquier cuenta del dominio corporativo.
allowed_domains = ["grefa.org"]
# Y, además, estas direcciones sueltas (colaboradores externos, por ejemplo).
allowed_emails = []
